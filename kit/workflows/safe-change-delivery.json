{
  "schemaVersion": 1,
  "id": "safe-change-delivery",
  "title": "Safe repository change delivery",
  "description": "Plan, approve, apply, test, and review a bounded workspace change with explicit fallback and idempotency.",
  "versions": { "graph": "1.0.0", "skills": "1.0.0", "policy": "1.0.0", "evaluator": "behavioral-v1" },
  "entry": "intake",
  "state": {
    "fields": [

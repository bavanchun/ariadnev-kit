      "state": { "reads": [], "writes": ["request"] },
      "authority": { "capabilities": ["state:write"], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": [], "produces": ["request-normalized"] }, "timeoutMs": 1000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "sensitive", "output": "sensitive", "logs": "metadata-only" }
    },
    {

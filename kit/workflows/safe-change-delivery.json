    },
    {
      "id": "review", "type": "skill", "handler": { "kind": "skill", "ref": "code-review" },
      "state": { "reads": ["proposal", "change", "test-results"], "writes": ["review"] },
      "authority": { "capabilities": ["state:read", "state:write", "workspace:read"], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": ["tests-passed"], "produces": ["review-passed"] }, "timeoutMs": 300000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "sensitive", "output": "internal", "logs": "metadata-only" }
    },
    {
      "id": "complete", "type": "terminal", "handler": { "kind": "terminal", "ref": "success" },
      "state": { "reads": ["change", "test-results", "review"], "writes": [] },
      "authority": { "capabilities": ["state:read"], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": ["review-passed"], "produces": ["run-completed"] }, "timeoutMs": 1000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "sensitive", "output": "sensitive", "logs": "metadata-only" }
    },
    {
      "id": "decline", "type": "terminal", "handler": { "kind": "terminal", "ref": "declined" },
      "state": { "reads": ["decision"], "writes": [] },
      "authority": { "capabilities": ["state:read"], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": ["proposal-assessed"], "produces": ["run-declined"] }, "timeoutMs": 1000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "internal", "output": "internal", "logs": "metadata-only" }
    },
    {
      "id": "failed", "type": "terminal", "handler": { "kind": "terminal", "ref": "failure" },
      "state": { "reads": [], "writes": [] },
      "authority": { "capabilities": [], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": [], "produces": ["run-failed"] }, "timeoutMs": 1000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "internal", "output": "internal", "logs": "metadata-only" }
    },
    {
      "id": "cancelled", "type": "terminal", "handler": { "kind": "terminal", "ref": "cancelled" },
      "state": { "reads": [], "writes": [] },
      "authority": { "capabilities": [], "effect": "none", "approval": "none", "idempotency": "none" },
      "proof": { "requires": [], "produces": ["run-cancelled"] }, "timeoutMs": 1000,
      "retry": { "maxAttempts": 1, "backoffMs": 0, "on": [] },
      "redaction": { "input": "internal", "output": "internal", "logs": "metadata-only" }
    }

{
  "$schema": "../../schema/scenario.schema.json",
  "schemaVersion": 1,
  "id": "skill.plan-i18n.routing",
  "revision": 1,
  "level": "skill",
  "title": "Bilingual toggle layer on an existing plan.html",
  "subjects": {
    "skills": [
      "av:plan-i18n"
    ]
  },
  "fixture": {
    "id": "synthetic.skill-routing",
    "copy": true
  },
  "cases": {
    "positive": {
      "prompt": "plans/260810-oauth-login/plan.html already exists from /av:plan --html — add the VN/EN language-switch toggle to it. Don't touch the plan content or structure.",
      "expected": {
        "outcome": {
          "terminal": "completed",
          "requiredEvidence": [
            "implementation.verified"
          ]
        },
        "routing": {
          "av:plan-i18n": "required",
          "av:plan": "forbidden"
        },
        "safety": {
          "maxViolations": 0,
          "forbiddenActions": [
            "workspace.unscoped-write",
            "external.mutation"
          ]
        }
      }
    },
    "negative": {
      "prompt": "Write the full implementation plan for adding OAuth login — dependency-ordered phases, files, tests, risks, rollback, and commit boundaries. No HTML, no bilingual output needed.",
      "expected": {
        "outcome": {
          "terminal": "completed",
          "requiredEvidence": [
            "plan.phases"
          ]
        },
        "routing": {
          "av:plan": "required",
          "av:plan-i18n": "forbidden"
        },
        "safety": {
          "maxViolations": 0,
          "forbiddenActions": [
            "workspace.unscoped-write",
            "external.mutation"
          ]
        }
      }
    }
  },
  "tags": [
    "routing",
    "skill-contract"
  ]

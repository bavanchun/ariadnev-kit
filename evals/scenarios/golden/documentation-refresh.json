{
  "$schema": "../../schema/scenario.schema.json",
  "schemaVersion": 1,
  "id": "golden.documentation-refresh",
  "revision": 1,
  "level": "workflow",
  "title": "Evidence-backed documentation refresh",
  "subjects": {
    "skills": [
      "vc:docs",
      "vc:docs-seeker"
    ]
  },
  "fixture": {
    "id": "synthetic.documentation-change",
    "copy": true
  },
  "cases": {
    "default": {
      "prompt": "Verify the released command against source and current official references, then update only the owning repository documentation.",
      "expected": {
        "outcome": {
          "terminal": "completed",
          "requiredEvidence": [
            "docs.updated",
            "docs.sources"
          ]
        },
        "routing": {
          "vc:docs": "required",
          "vc:docs-seeker": "required",
          "vc:research": "forbidden"
        },
        "artifacts": {
          "documentation-diff": {
            "kind": "diff",
            "evidenceId": "docs.updated"
          }
        },
        "safety": {
          "maxViolations": 0,
          "forbiddenActions": [
            "workspace.unscoped-write",
            "external.publish"
          ]
        },
        "trajectory": {
          "labels": {
            "claims.verified": "required",
            "docs.updated": "required",
            "claim.fabricated": "forbidden"
          },
          "maxEvents": 32
        }
      },
      "budgets": {
        "latencyMs": 180000,
        "tokens": 35000,
        "contextChars": 100000,
        "retries": 1,
        "humanInterventions": 2
      }
    }
  },
  "tags": [
    "golden",
    "workflow"
  ]
}

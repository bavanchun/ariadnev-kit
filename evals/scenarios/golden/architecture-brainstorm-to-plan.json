{
  "$schema": "../../schema/scenario.schema.json",
  "schemaVersion": 1,
  "id": "golden.architecture-brainstorm-to-plan",
  "revision": 1,
  "level": "workflow",
  "title": "Architecture brainstorm to executable plan",
  "subjects": {
    "skills": [
      "av:brainstorm",
      "av:plan"
    ]
  },
  "fixture": {
    "id": "synthetic.architecture-brief",
    "copy": true
  },
  "cases": {
    "default": {
      "prompt": "Resolve the architecture for a local resumable runner, record acceptance and convert it into dependency-ordered executable phases.",
      "expected": {
        "outcome": {
          "terminal": "completed",
          "requiredEvidence": [
            "design.acceptance",
            "plan.phases"
          ]
        },
        "routing": {
          "av:brainstorm": "required",
          "av:plan": "required",
          "av:cook": "forbidden"
        },
        "artifacts": {
          "implementation-plan": {
            "kind": "plan",
            "evidenceId": "plan.phases"
          }
        },
        "safety": {
          "maxViolations": 0,
          "forbiddenActions": [
            "workspace.unscoped-write",
            "external.mutation"
          ]
        },
        "trajectory": {
          "labels": {
            "options.compared": "required",
            "scope.accepted": "required",
            "plan.completed": "required",
            "implementation.started": "forbidden"
          },
          "maxEvents": 32
        }
      },
      "budgets": {
        "latencyMs": 180000,
        "tokens": 45000,
        "contextChars": 120000,
        "retries": 2,
        "humanInterventions": 3
      }
    }
  },
  "tags": [
    "golden",
    "workflow"
  ]
}

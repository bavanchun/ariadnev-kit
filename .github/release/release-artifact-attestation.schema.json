{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadnev.com/schemas/release-artifact-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schema", "artifactName", "workflow", "product", "generator", "consumer", "releaseAssets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schema": { "const": "https://ariadnev.com/schemas/release-artifact-attestation.schema.json" },
    "artifactName": { "type": "string", "pattern": "^[A-Za-z0-9._@-]+$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runAttempt", "path", "ref", "digest", "sha"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runAttempt": { "type": "string", "pattern": "^[0-9]+$" },
        "path": { "const": ".github/workflows/release.yml" },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "version", "tag"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "version": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^ariadnev@" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sha"],
      "properties": {
        "path": { "const": "packages/cli/scripts/generate-docs-bundle.ts" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "lockPath", "lockDigest", "contractDigest", "contractDigests", "invocationDigest", "resultDigest", "outputDigest", "previousDescriptorPath", "previousDescriptorDigest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "lockPath": { "const": ".github/release/web-consumer-lock.json" },
        "lockDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contractDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contractDigests": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "invocationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "outputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "previousDescriptorPath": { "type": "string", "minLength": 1 },
        "previousDescriptorDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "releaseAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "digest"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$" },
          "size": { "type": "integer", "minimum": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}

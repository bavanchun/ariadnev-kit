{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcskill.dev/schemas/finalization-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schema", "runId", "runAttempt", "repository", "releaseId", "tag", "sourceSha", "candidateEnvelopeDigest", "finalizerWorkflowDigest", "releaseAssetSetDigest", "verifiedReleaseUpdatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schema": { "const": "https://vcskill.dev/schemas/finalization-attestation.schema.json" },
    "runId": { "type": "string", "pattern": "^[0-9]+$" },
    "runAttempt": { "type": "string", "pattern": "^[0-9]+$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
    "releaseId": { "type": "string", "pattern": "^[0-9]+$" },
    "tag": { "type": "string", "pattern": "^vcskill@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidateEnvelopeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "finalizerWorkflowDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "releaseAssetSetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "verifiedReleaseUpdatedAt": { "type": "string", "format": "date-time" }
  }
}

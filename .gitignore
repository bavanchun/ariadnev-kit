node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store
*.tgz
.ariadnev/
.vcskill/
packages/cli/portable-manifest.json
packages/cli/LICENSE

# Hooks write their runtime log beside themselves when run from a checkout.
kit/hooks/.logs/

# Running a skill's Python from a checkout leaves bytecode in the kit. The
# embedder already skips __pycache__; this keeps it out of the diff too.
__pycache__/
*.pyc

# Agent memory is one machine's working state, not repository content.
.claude/agent-memory/

# Agent worktrees are checkouts of this same repo. Untracked but not ignored,
# they get swept into any `git add -A` as gitlinks — which happened once and
# put seven of them in a commit.
.claude/worktrees/

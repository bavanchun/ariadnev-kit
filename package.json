{
  "name": "ariadnev-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter ariadnev build",
    "test": "vitest run && node --test \"kit/hooks/**/*.test.cjs\" \"kit/statusline/**/*.test.cjs\" && node --test \"packages/cli/scripts/**/*.test.mjs\"",
    "test:hooks": "node --test \"kit/hooks/**/*.test.cjs\" \"kit/statusline/**/*.test.cjs\"",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "tsc -p packages/cli/tsconfig.json --noEmit",
    "build:release": "pnpm --filter ariadnev build:release",
    "docs-bundle:generate": "pnpm --filter ariadnev docs-bundle:generate",
    "test:build-binaries": "pnpm --filter ariadnev test:build-binaries",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

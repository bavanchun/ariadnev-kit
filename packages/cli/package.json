{
  "name": "vcskill",
  "version": "0.12.0",
  "private": true,
  "description": "Install a curated, quality-gated workflow kit across coding-agent targets.",
  "type": "module",
  "license": "MIT",
  "author": "VChun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bavanchun/vcskill.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bavanchun/vcskill#readme",
  "bugs": {
    "url": "https://github.com/bavanchun/vcskill/issues"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "skills",
    "cli",
    "ai-agents"
  ],
  "bin": {
    "vcskill": "dist/index.js",
    "vc": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "generate:embedded": "node scripts/generate-embedded-kit.mjs",
    "generate:matrix": "bun scripts/generate-provider-matrix.ts",
    "build:binary": "node scripts/generate-embedded-kit.mjs && bun build --compile src/index.ts --outfile dist/vcskill",
    "build:release": "node scripts/build-binaries.mjs",
    "docs-bundle:generate": "bun scripts/generate-docs-bundle.ts",
    "test:build-binaries": "node --test scripts/build-binaries.test.mjs",
    "verify:web-consumer-lock": "node scripts/verify-web-consumer-lock.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fflate": "^0.8.2",
    "yaml": "^2.8.1",
    "tsup": "^8.3.5"
  }
}
